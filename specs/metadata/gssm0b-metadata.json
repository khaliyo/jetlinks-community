      "valueType": {
        "type": "int",
        "unit": "MB"
      },
      "expands": {
        "source": "device",
        "type": ["read", "report"],
        "storageType": "direct"
      }
    },
    {
      "id": "sdCardTotalSpace",
      "name": "SD卡总大小",
      "description": "单位 MB",
