    {
      "id": "playerMode",
      "name": "播放模式",
      "description": "OnePlay/OneLoopPlay/ListPlay/ListLoopPlay",
      "valueType": {
        "type": "enum",
        "elements": [
          { "value": "OnePlay", "text": "单曲播放" },
          { "value": "OneLoopPlay", "text": "单曲循环" },
          { "value": "ListPlay", "text": "列表播放" },
          { "value": "ListLoopPlay", "text": "列表循环" }
        ]
      },
      "expands": {
        "source": "device",
        "type": ["read", "write", "report"],
        "storageType": "direct"
      }
