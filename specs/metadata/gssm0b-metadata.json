        "type": "string"
      },
      "expands": {
        "source": "device",
        "type": ["read", "report"],
        "storageType": "direct"
      }
    },
    {
      "id": "eqValue",
      "name": "EQ值",
      "description": "20 段 EQ 增益 JSON 数组，范围 -13~13 dB",
      "valueType": {
        "type": "string"
      },
      "expands": {
        "source": "device",
        "type": ["read", "write", "report"],
        "storageType": "direct"
      }
    },
    {
      "id": "fileCount",
      "name": "文件数量",
      "valueType": {
        "type": "int"
      },
