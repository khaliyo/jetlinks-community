{
  "profileVersion": "1",
  "productId": "gspw1b2",
  "name": "GSPW1B2智能86插座",
  "deviceModelHint": "Socket-86-10A-new",
  "topic": {
    "upstream": "/{productId}/{deviceId}/up",
    "downstream": "/{productId}/{deviceId}/down"
  },
  "propertyMapping": {
    "key": "switchState",
    "current": "current",
    "power": "power",
    "voltage": "voltage",
    "energy": "energy",
    "signal": "signal",
    "onState": "onState",
    "keyLock": "keyLock",
    "wifiLock": "wifiLock",
    "timerEnable": "timerEnable",
    "timerInterval": "timerInterval",
    "countdownSecond": "countdownSecond",
    "remainingSecond": "remainingSecond",
    "state": "countdownState",
    "finishCommand": "finishCommand",
    "number": "timerTaskNumber",
    "hour": "timerTaskHour",
    "minute": "timerTaskMinute",
    "repeat": "timerTaskRepeat",
    "command.key": "timerTaskCommandKey",
    "version": "version",
    "ip": "ip",
    "ssid": "ssid",
    "mac": "mac",
    "type": "deviceType",
    "commandName": "lastCommandName",
    "source": "lastSource"
  },
  "enumProperties": [
    "switchState",
    "onState",
    "keyLock",
    "wifiLock",
    "timerEnable",
    "countdownState",
    
    "timerTaskCommandKey"
  ],
  "intProperties": [
    "signal",
    "timerInterval",
    "countdownSecond",
    "remainingSecond",
    "timerTaskNumber",
    "timerTaskHour",
    "timerTaskMinute"
  ],
  "floatProperties": [
    "current",
    "power",
    "voltage",
    "energy"
  ],
  "commandResponse": {
    "rules": [
      {
        "source": "command"
      },
      {
        "commandNameIn": [
          "info-all",
          "info-statistic",
          "setting-timer-countdown-active"
        ],
        "sourceNot": "auto",
        "requireMessageId": true
      }
    ]
  },
  "events": {
    "controllerEvent": {
      "match": {
        "commandName": "controller-event"
      },
      "payload": [
        "key",
        "onState",
        "mac"
      ]
    }
  },
  "functions": {
    "powerControl": {
      "downstream": {
        "type": "event",
        "fields": {
          "key": "${inputs.key}"
        }
      }
    },
    "restart": {
      "downstream": {
        "type": "setting",
        "fields": {
          "system": "restart"
        }
      }
    },
    "reset": {
      "downstream": {
        "type": "setting",
        "fields": {
          "system": "reset"
        }
      }
    },
    "energyClear": {
      "downstream": {
        "type": "setting",
        "fields": {
          "system": "energy-clear"
        }
      }
    },
    "queryInfo": {
      "downstream": {
        "type": "info",
        "fields": {}
      }
    },
    "queryStatistic": {
      "downstream": {
        "type": "statistic",
        "fields": {}
      }
    },
    "queryProtocol": {
      "downstream": {
        "type": "protocol",
        "fields": {}
      }
    },
    "queryCountdownActive": {
      "downstream": {
        "type": "setting",
        "fields": {}
      }
    },
    "setTimerReport": {
      "downstream": {
        "type": "setting",
        "fields": {
          "timerEnable": "${inputs.timerEnable}",
          "timerInterval": "${inputs.timerInterval}"
        }
      }
    },
    "setKeyLock": {
      "downstream": {
        "type": "setting",
        "fields": {
          "keyLock": "${inputs.keyLock}"
        }
      }
    },
    "setOnState": {
      "downstream": {
        "type": "setting",
        "fields": {
          "onState": "${inputs.onState}"
        }
      }
    },
    "setWifiLock": {
      "downstream": {
        "type": "setting",
        "fields": {
          "wifiLock": "${inputs.wifiLock}"
        }
      }
    },
    "setCountdown": {
      "downstream": {
        "type": "setting",
        "fields": {
          "task": "countdown",
          "countdownSecond": "${inputs.countdownSecond}",
          "finishCommand": {
            "key": "${inputs.finishCommandKey}",
            "type": "event"
          },
          "timerInterval": "${inputs.timerInterval}"
        }
      }
    },
    "clearCountdown": {
      "downstream": {
        "type": "setting",
        "fields": {
          "task": "countdown-clear"
        }
      }
    },
    "setTimerTask": {
      "downstream": {
        "type": "setting",
        "fields": {
          "task": "timer",
          "number": "${inputs.number}",
          "hour": "${inputs.hour}",
          "minute": "${inputs.minute}",
          "repeat": "${inputs.repeat}",
          "command": {
            "key": "${inputs.commandKey}",
            "type": "event"
          }
        }
      }
    },
    "deleteTimerTask": {
      "downstream": {
        "type": "setting",
        "fields": {
          "action": "delete",
          "number": "${inputs.number}"
        }
      }
    },
    "setCustomMqtt": {
      "downstream": {
        "type": "custom",
        "fields": {
          "clientId": "${inputs.clientId}",
          "password": "${inputs.password}",
          "port": "${inputs.port}",
          "protocol": "${inputs.protocol}",
          "publish": "${inputs.publish}",
          "server": "${inputs.server}",
          "subcribe": "${inputs.subcribe}",
          "type": "custom",
          "username": "${inputs.username}"
        }
      }
    },
    "setCustomTcp": {
      "downstream": {
        "type": "custom",
        "fields": {
          "port": "${inputs.port}",
          "protocol": "${inputs.protocol}",
          "server": "${inputs.server}",
          "type": "custom"
        }
      }
    }
  },
  "writeProperties": {
    "switchState": {
      "downstream": {
        "type": "event",
        "fields": {
          "key": "${value}"
        }
      }
    },
    "timerEnable": {
      "downstream": {
        "type": "setting",
        "fields": {
          "timerEnable": "${value}"
        }
      }
    },
    "timerInterval": {
      "downstream": {
        "type": "setting",
        "fields": {
          "timerInterval": "${value}"
        }
      }
    },
    "onState": {
      "downstream": {
        "type": "setting",
        "fields": {
          "onState": "${value}"
        }
      }
    },
    "keyLock": {
      "downstream": {
        "type": "setting",
        "fields": {
          "keyLock": "${value}"
        }
      }
    },
    "wifiLock": {
      "downstream": {
        "type": "setting",
        "fields": {
          "wifiLock": "${value}"
        }
      }
    }
  }
}
